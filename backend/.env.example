# Environment Variables Template for AI Emergency Health Passport Backend
# Copy this file to backend/.env and fill in your actual values
# IMPORTANT: Never commit the real .env file to git (add to .gitignore)

# ─────────────────────────────────────────────────────────────────────
# MONGODB ATLAS CONFIGURATION
# ─────────────────────────────────────────────────────────────────────
# Get this from MongoDB Atlas connection string (SRV format recommended)
# Format: mongodb+srv://username:password@cluster-name.mongodb.net/?retryWrites=true&w=majority
# Do NOT hardcode in code; always use environment variable
MONGO_URL=mongodb+srv://username:password@cluster-name.mongodb.net/?retryWrites=true&w=majority

# MongoDB database name (optional; defaults to ai_emergency_health_passport)
MONGO_DB_NAME=ai_emergency_health_passport

# ─────────────────────────────────────────────────────────────────────
# AUTHENTICATION
# ─────────────────────────────────────────────────────────────────────
# Generate with: python -c \"import secrets; print(secrets.token_urlsafe(32))\"
# Must be at least 32 characters for production security
JWT_SECRET=your-secret-key-here-minimum-32-characters-for-production

# ─────────────────────────────────────────────────────────────────────
# CORS (Cross-Origin Resource Sharing)
# ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
# For local development: http://localhost:3000,http://localhost:3001,http://localhost:3002
# For production: https://your-domain.com,https://api.your-domain.com
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:3002

# Regex pattern for dynamic CORS origin matching
# Matches all subdomains of onrender.com when deployed
CORS_ALLOW_ORIGIN_REGEX=https://.*\.onrender\.com

# ─────────────────────────────────────────────────────────────────────
# DEBUGGING & LOGGING
# ─────────────────────────────────────────────────────────────────────
# Set to true to enable debug logging for drug interaction checker
DRUG_INTERACTION_DEBUG=false

# ─────────────────────────────────────────────────────────────────────
# RENDER.COM DEPLOYMENT NOTES
# ─────────────────────────────────────────────────────────────────────
# 1. Do NOT put this file in git. Add \"backend/.env\" to .gitignore
# 2. Set secret variables in Render dashboard (not in render.yaml)
# 3. MONGO_URL should be marked as \"secret\" in Render
# 4. JWT_SECRET should be marked as \"secret\" in Render
# 5. Non-secret vars can be in render.yaml or Render dashboard

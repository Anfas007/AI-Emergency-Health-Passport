# Production Dockerfile for AI Emergency Health Passport Backend\n# Optimized for Render.com deployment\n# Build: docker build -t health-passport-backend .\n# Run: docker run -p 8000:8000 --env-file .env health-passport-backend\n\nFROM python:3.11-slim\n\n# Set working directory\nWORKDIR /app\n\n# Set Python environment variables\nENV PYTHONUNBUFFERED=1 \\\n    PYTHONDONTWRITEBYTECODE=1 \\\n    PIP_NO_CACHE_DIR=1 \\\n    PIP_DISABLE_PIP_VERSION_CHECK=1\n\n# Install system dependencies\nRUN apt-get update && apt-get install -y --no-install-recommends \\\n    gcc \\\n    && rm -rf /var/lib/apt/lists/*\n\n# Copy requirements and install dependencies\nCOPY requirements.txt .\nRUN pip install --upgrade pip && \\\n    pip install -r requirements.txt\n\n# Copy application code\nCOPY . .\n\n# Create uploads directory\nRUN mkdir -p uploads\n\n# Health check endpoint\nHEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \\\n    CMD python -c \"import urllib.request; urllib.request.urlopen('http://localhost:${PORT:-8000}/health')\"\n\n# Expose port (Render injects $PORT, default 10000)\nEXPOSE ${PORT:-10000}\n\n# Run application\nCMD [\"python\", \"main.py\"]\n